@startuml
skinparam defaultFontName "Segoe UI"
skinparam roundCorner 8
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3

' Style Entities with subtle modern tones
skinparam class {
    BackgroundColor #F8FAFC
    BorderColor #64748B
    HeaderBackgroundColor #E2E8F0
}

entity "profiles (USERS)" as users #EFF6FF {
    * id : uuid <<PK, FK auth.users>>
    --
    * user_id : varchar(20) <<CIT-U ID>>
    * first_name : varchar(100)
    * last_name : varchar(100)
    * email : varchar(150) <<@cit.edu>>
    contact_number : varchar(30)
    role : varchar(30) <<STUDENT, FACULTY, MDC_STAFF, ADMIN>>
    is_staff : boolean
    avatar_url : text
    created_at : timestamptz
}

entity "pets" as pets #F0FDF4 {
    * pet_id : varchar(50) <<PK>>
    --
    * name : varchar(100)
    species : varchar(30) <<Cat, Dog>>
    breed : varchar(50)
    gender : varchar(10)
    age : varchar(30)
    pet_type : varchar(30) <<Campus Wildcat, Rescue>>
    adoption_status : varchar(30) <<Available, Pending, Adopted>>
    vaccination_status : varchar(30) <<Up to Date, Overdue>>
    spayed_neutered : boolean
    primary_image : text
    qr_collar_tag_code : varchar(50)
    rescue_date : date
    current_conditions : text
    behavior_notes : text
    about_text : text
    created_at : timestamptz
}

entity "medical_records" as medical #FFF1F2 {
    * record_id : bigint <<PK, identity>>
    --
    * pet_id : varchar(50) <<FK>>
    visit_type : varchar(50) <<Routine, Bite/Scratch Incident, Injury>>
    log_date : date
    attending_staff : varchar(100)
    weight_kg : numeric(5,2)
    clinical_notes : text
    diagnosis : text
    treatment : text
    is_bite_scratch_incident : boolean
    quarantine_14day_active : boolean <<RA 9482 Biosecurity>>
    victim_details : text
    auto_reminder : boolean
    created_at : timestamptz
}

entity "vaccination_logs" as vaccines #FDF2F8 {
    * vaccine_id : bigint <<PK, identity>>
    --
    * pet_id : varchar(50) <<FK>>
    vaccine_name : varchar(100) <<Anti-Rabies, 4-in-1, Deworming>>
    batch_number : varchar(50)
    administered_date : date
    expiration_date : date
    next_due_date : date
    administered_by : varchar(100)
}

entity "adoption_applications" as adoptions #F5F3FF {
    * application_id : bigint <<PK, identity>>
    --
    * pet_id : varchar(50) <<FK>>
    applicant_id : uuid <<FK profiles.id>>
    full_name : varchar(150)
    contact_number : varchar(30)
    email : varchar(150)
    residential_address : text
    experience_level : varchar(50)
    housing_type : varchar(50)
    has_secure_fence : boolean
    household_agreement : boolean
    pet_care_budget : varchar(50)
    plan_if_moving : text
    application_status : varchar(30) <<Pending, Approved, Denied>>
    submitted_at : timestamptz
    reviewed_by : uuid <<FK profiles.id>>
    reviewed_at : timestamptz
}

entity "inventory" as inventory #FFFBEB {
    * item_id : bigint <<PK, identity>>
    --
    * item_name : varchar(150)
    category : varchar(50) <<Medical, Food, Sanitation>>
    unit : varchar(20) <<kg, cans, vials, pieces>>
    quantity : numeric(10,2)
    min_threshold : numeric(10,2)
    donor_attribution : varchar(150)
    expiration_date : date
    updated_at : timestamptz
}

entity "inventory_transactions" as inv_tx #FEF3C7 {
    * tx_id : bigint <<PK, identity>>
    --
    * item_id : bigint <<FK inventory.item_id>>
    transaction_type : varchar(20) <<INFLOW, OUTFLOW>>
    quantity_changed : numeric(10,2)
    reason : varchar(200) <<Consumption, Restock, Spoilage>>
    supplier_donor : varchar(150)
    logged_at : timestamptz
    logged_by : uuid <<FK profiles.id>>
}

entity "animal_sightings" as sightings #ECFDF5 {
    * sighting_id : bigint <<PK, identity>>
    --
    landmark_location : varchar(100) <<NGE, Canteen, Quad>>
    building_zone : varchar(50)
    animal_description : text
    condition_tags : varchar(100)
    photo_url : text
    reporter_id : uuid <<FK profiles.id>>
    reporter_contact : varchar(50)
    status : varchar(30) <<Open, Under Review, Dispatched, Resolved>>
    created_at : timestamptz
}

' Entity Relationships (Crow's Foot notation)
pets ||--o{ medical : "receives (1:N)"
pets ||--o{ vaccines : "administered (1:N)"
pets ||--o{ adoptions : "applied for (1:N)"
users ||--o{ adoptions : "submits (1:N)"
users ||--o{ medical : "attends / logs (1:N)"
users ||--o{ sightings : "reports (1:N)"
inventory ||--o{ inv_tx : "tracked in (1:N)"
users ||--o{ inv_tx : "authorizes (1:N)"

@enduml