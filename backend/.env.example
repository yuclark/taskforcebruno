# Django core settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-chars
DEBUG=True

# Supabase credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: enables local HS256 JWT signature verification without extra GoTrue roundtrips
SUPABASE_JWT_SECRET=

# Optional: direct Postgres URL for Render deployment
DATABASE_URL=

# CORS allowed frontend origin
FRONTEND_VERCEL_URL=http://localhost:5173
